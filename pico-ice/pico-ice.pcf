# 12 MHz clock (from Pico)
set_io clk_ext          35

# Onboard LEDs
set_io led_blue         39
set_io led_green        40
set_io led_red          41

# Button
set_io button_in        10

# Loop Forever
set_io loop_forever_in  11

# IR LED
set_io ir_led_out       3
set_io ir_ledn_out      6

# Status LEDs
set_io active_led_out  	4
set_io fail_led_out	48
